vars: {d2-config: {layout-engine: elk; pad: 28}}
(** -> **)[*].style: {stroke: "#64748B"; stroke-width: 2; font-size: 14; font-color: "#1E293B"; italic: false}
(** <-> **)[*].style: {stroke: "#64748B"; stroke-width: 2; font-size: 14; font-color: "#1E293B"; italic: false}
classes: {
  emp: {style: {fill: "#E6F4F1"; stroke: "#0F766E"; stroke-width: 2; border-radius: 10; font-color: "#0B3B36"}}
  mgr: {style: {fill: "#EEF0FF"; stroke: "#4338CA"; stroke-width: 2; border-radius: 10; font-color: "#1E1B4B"}}
  sys: {style: {fill: "#FEF6E4"; stroke: "#B45309"; stroke-width: 2; border-radius: 10; font-color: "#451A03"}}
  ai: {style: {fill: "#F3EEFF"; stroke: "#7C3AED"; stroke-width: 2; border-radius: 10; font-color: "#2E1065"}}
  ok: {style: {fill: "#EAF7EE"; stroke: "#15803D"; stroke-width: 2; border-radius: 10; font-color: "#052E16"}}
  bad: {style: {fill: "#FDECEC"; stroke: "#B91C1C"; stroke-width: 2; border-radius: 10; font-color: "#450A0A"}}
  ext: {style: {fill: "#FFF3EB"; stroke: "#C2410C"; stroke-width: 2; border-radius: 10; font-color: "#431407"}}
  neu: {style: {fill: "#F8FAFC"; stroke: "#475569"; stroke-width: 2; border-radius: 10; font-color: "#0F172A"}}
  db: {shape: cylinder; style: {fill: "#F1F5F9"; stroke: "#334155"; stroke-width: 2; font-color: "#0F172A"}}
  q: {shape: diamond; style: {fill: "#FFFFFF"; stroke: "#475569"; stroke-width: 2; font-color: "#0F172A"; font-size: 15}}
  grp: {style: {fill: "#FBFCFD"; stroke: "#94A3B8"; stroke-width: 1; border-radius: 14; font-color: "#334155"; font-size: 19; bold: true}}
  grpv: {style: {fill: "#FBF9FF"; stroke: "#A78BFA"; stroke-width: 1; border-radius: 14; font-color: "#4C1D95"; font-size: 19; bold: true}}
  qr: {shape: rectangle; style: {fill: "#FFFFFF"; stroke: "#475569"; stroke-width: 2; border-radius: 22; font-color: "#0F172A"; font-size: 15}}
  note: {shape: page; style: {fill: "#FFFBEB"; stroke: "#B45309"; stroke-width: 1; font-color: "#451A03"}}
}
grid-columns: 2
grid-gap: 50
w_expenses: {
  label: ""
  style: {fill: transparent; stroke: transparent}
  expenses: {
  shape: sql_table
  style: {fill: "#115E59"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; font-size: 16}
  expense_id: "integer" {constraint: [primary_key]}
  expense_code: "text" {constraint: [unique]}
  ticket_id: "integer" {constraint: [foreign_key]}
  trip_id: "integer" {constraint: [foreign_key]}
  evidence_id: "uuid" {constraint: [foreign_key; unique]}
  expense_type: "text"
  amount: "numeric(12,2)"
  currency: "char(3)"
  expense_date: "date"
  description: "text"
  invoice_number: "text"
  status: "text"
  created_at: "timestamptz"
  receipt_verdict: "text"
  receipt_checks: "jsonb"
  }
}
w_expense_tickets: {
  label: ""
  style: {fill: transparent; stroke: transparent}
  expense_tickets: {
  shape: sql_table
  style: {fill: "#115E59"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; font-size: 16}
  ticket_id: "integer" {constraint: [primary_key]}
  ticket_code: "text" {constraint: [unique]}
  trip_id: "integer" {constraint: [foreign_key]}
  employee_id: "integer" {constraint: [foreign_key]}
  replacement_of_ticket_id: "integer" {constraint: [foreign_key; unique]}
  status: "text"
  routing: "text"
  line_count: "integer"
  flag_count: "integer"
  total_amount: "numeric(12,2)"
  submitted_at: "timestamptz"
  decided_at: "timestamptz"
  }
}
w_policy_flags: {
  label: ""
  style: {fill: transparent; stroke: transparent}
  policy_flags: {
  shape: sql_table
  style: {fill: "#115E59"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; font-size: 16}
  flag_id: "integer" {constraint: [primary_key]}
  expense_id: "integer" {constraint: [foreign_key]}
  rule_code: "text"
  message: "text"
  policy_ref: "text"
  threshold_amount: "numeric(12,2)"
  rules_version: "text"
  created_at: "timestamptz"
  }
}
w_ticket_approvals: {
  label: ""
  style: {fill: transparent; stroke: transparent}
  ticket_approvals: {
  shape: sql_table
  style: {fill: "#115E59"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; font-size: 16}
  approval_id: "integer" {constraint: [primary_key]}
  ticket_id: "integer" {constraint: [foreign_key; unique]}
  reviewer_type: "text"
  reviewer_id: "integer" {constraint: [foreign_key]}
  decision: "text"
  rejection_reason: "text"
  review_comment: "text"
  decided_at: "timestamptz"
  }
}
w_travel_requests: {
  label: ""
  style: {fill: transparent; stroke: transparent}
  travel_requests: {
  shape: sql_table
  style: {fill: "#115E59"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; font-size: 16}
  trip_id: "integer" {constraint: [primary_key]}
  trip_code: "text" {constraint: [unique]}
  created_on: "date"
  "...": "see its own figure"
  }
}
w_expense_tickets.expense_tickets.trip_id -> w_travel_requests.travel_requests.trip_id
w_expenses.expenses.ticket_id -> w_expense_tickets.expense_tickets.ticket_id
w_expenses.expenses.trip_id -> w_travel_requests.travel_requests.trip_id
w_policy_flags.policy_flags.expense_id -> w_expenses.expenses.expense_id
w_ticket_approvals.ticket_approvals.ticket_id -> w_expense_tickets.expense_tickets.ticket_id
