vars: {d2-config: {layout-engine: elk; pad: 28}}
(** -> **)[*].style: {stroke: "#64748B"; stroke-width: 2; font-size: 14; font-color: "#1E293B"; italic: false}
(** <-> **)[*].style: {stroke: "#64748B"; stroke-width: 2; font-size: 14; font-color: "#1E293B"; italic: false}
classes: {
  emp: {style: {fill: "#E6F4F1"; stroke: "#0F766E"; stroke-width: 2; border-radius: 10; font-color: "#0B3B36"}}
  mgr: {style: {fill: "#EEF0FF"; stroke: "#4338CA"; stroke-width: 2; border-radius: 10; font-color: "#1E1B4B"}}
  sys: {style: {fill: "#FEF6E4"; stroke: "#B45309"; stroke-width: 2; border-radius: 10; font-color: "#451A03"}}
  ai: {style: {fill: "#F3EEFF"; stroke: "#7C3AED"; stroke-width: 2; border-radius: 10; font-color: "#2E1065"}}
  ok: {style: {fill: "#EAF7EE"; stroke: "#15803D"; stroke-width: 2; border-radius: 10; font-color: "#052E16"}}
  bad: {style: {fill: "#FDECEC"; stroke: "#B91C1C"; stroke-width: 2; border-radius: 10; font-color: "#450A0A"}}
  ext: {style: {fill: "#FFF3EB"; stroke: "#C2410C"; stroke-width: 2; border-radius: 10; font-color: "#431407"}}
  neu: {style: {fill: "#F8FAFC"; stroke: "#475569"; stroke-width: 2; border-radius: 10; font-color: "#0F172A"}}
  db: {shape: cylinder; style: {fill: "#F1F5F9"; stroke: "#334155"; stroke-width: 2; font-color: "#0F172A"}}
  q: {shape: diamond; style: {fill: "#FFFFFF"; stroke: "#475569"; stroke-width: 2; font-color: "#0F172A"; font-size: 15}}
  grp: {style: {fill: "#FBFCFD"; stroke: "#94A3B8"; stroke-width: 1; border-radius: 14; font-color: "#334155"; font-size: 19; bold: true}}
  grpv: {style: {fill: "#FBF9FF"; stroke: "#A78BFA"; stroke-width: 1; border-radius: 14; font-color: "#4C1D95"; font-size: 19; bold: true}}
  qr: {shape: rectangle; style: {fill: "#FFFFFF"; stroke: "#475569"; stroke-width: 2; border-radius: 22; font-color: "#0F172A"; font-size: 15}}
  note: {shape: page; style: {fill: "#FFFBEB"; stroke: "#B45309"; stroke-width: 1; font-color: "#451A03"}}
}
grid-columns: 2
grid-gap: 50
w_chat_conversations: {
  label: ""
  style: {fill: transparent; stroke: transparent}
  chat_conversations: {
  shape: sql_table
  style: {fill: "#115E59"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; font-size: 16}
  conversation_id: "uuid" {constraint: [primary_key]}
  session_id: "uuid" {constraint: [foreign_key]}
  turn_number: "integer"
  intent: "text"
  status: "text"
  guardrail_status: "text"
  guardrail_reasons: "text array"
  error_code: "text"
  model_name: "text"
  latency_ms: "integer"
  request_id: "text"
  correlation_id: "text"
  created_at: "timestamptz"
  }
}
w_chat_messages: {
  label: ""
  style: {fill: transparent; stroke: transparent}
  chat_messages: {
  shape: sql_table
  style: {fill: "#115E59"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; font-size: 16}
  message_id: "bigint" {constraint: [primary_key]}
  session_id: "uuid" {constraint: [foreign_key]}
  conversation_id: "uuid" {constraint: [foreign_key]}
  sequence_no: "integer"
  message_type: "text"
  content: "text"
  tool_name: "text"
  tool_call_id: "text"
  tool_args: "jsonb"
  metadata: "jsonb"
  created_at: "timestamptz"
  }
}
w_chat_sessions: {
  label: ""
  style: {fill: transparent; stroke: transparent}
  chat_sessions: {
  shape: sql_table
  style: {fill: "#115E59"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; font-size: 16}
  session_id: "uuid" {constraint: [primary_key]}
  employee_id: "integer" {constraint: [foreign_key]}
  status: "text"
  close_reason: "text"
  summary: "text"
  summarized_upto_turn: "integer"
  started_at: "timestamptz"
  last_activity_at: "timestamptz"
  closed_at: "timestamptz"
  }
}
w_policy_chunks: {
  label: ""
  style: {fill: transparent; stroke: transparent}
  policy_chunks: {
  shape: sql_table
  style: {fill: "#115E59"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; font-size: 16}
  chunk_id: "integer" {constraint: [primary_key]}
  ref_id: "text"
  section_title: "text"
  chunk_index: "integer"
  content: "text"
  embedding: "real array"
  source_file: "text"
  content_hash: "text" {constraint: [unique]}
  }
}
w_employees: {
  label: ""
  style: {fill: transparent; stroke: transparent}
  employees: {
  shape: sql_table
  style: {fill: "#115E59"; stroke: "#FFFFFF"; font-color: "#FFFFFF"; font-size: 16}
  employee_id: "integer" {constraint: [primary_key]}
  full_name: "text"
  "...": "see its own figure"
  }
}
w_chat_sessions.chat_sessions.employee_id -> w_employees.employees.employee_id
w_chat_conversations.chat_conversations.session_id -> w_chat_sessions.chat_sessions.session_id
w_chat_messages.chat_messages.session_id -> w_chat_sessions.chat_sessions.session_id
w_chat_messages.chat_messages.conversation_id -> w_chat_conversations.chat_conversations.conversation_id
