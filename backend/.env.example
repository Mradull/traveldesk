# =============================================================================
# TravelDesk backend  —  .env.example   (Agile Spec v2.0)
# Copy to backend/.env and fill in real values:   cp .env.example .env
# NEVER commit backend/.env (it is in .gitignore). Commit only this example file.
# Every variable is read by backend/app/core/config.py (pydantic-settings).
# React never sees this file; the frontend only knows VITE_API_BASE_URL.
# Placeholders look like <this> or change-me-...; replace them all.
# =============================================================================

# ---------- Application ----------
APP_NAME=TravelDesk API
APP_ENV=development                 # development | test | production
API_PREFIX=/api/v1
TZ=Asia/Kolkata                     # every teammate's backend must use the same time zone
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                     # json | text
CORS_ORIGINS=http://localhost:5173  # comma-separated list of allowed React origins
COMPANY_NAME=Veridian Global Services
ASSISTANT_NAME=Vera

# ---------- Database: local PostgreSQL, administered with pgAdmin ----------
# PostgreSQL stores the data; pgAdmin is only the client used to inspect and administer it.
# pgAdmin server registration (same server as below):
#   Name: TravelDesk Local | Host: localhost | Port: 5432 | Maintenance DB: postgres | Username: postgres
# Create the databases once (pgAdmin > Query Tool):  CREATE DATABASE traveldesk;  CREATE DATABASE traveldesk_test;
# Driver prefix "postgresql+psycopg" = SQLAlchemy + psycopg 3. URL-encode special characters
# in the password (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/traveldesk
# Used only by pytest. Tests TRUNCATE tables, so it must be a SEPARATE database.
TEST_DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/traveldesk_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=5000        # any single SQL statement is cancelled after 5 s

# ---------- Auth: JWT ----------
# POST /api/v1/auth/login checks e-mail + bcrypt password hash and returns a signed JWT.
# React sends it as "Authorization: Bearer <token>" on every request.
# Generate ONE secret for the whole team and share it privately:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Every backend must use the SAME secret, or a token from one machine fails on another.
JWT_SECRET_KEY=change-me-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60  # no refresh token: after expiry the user signs in again
# Password given to every seeded demo user by scripts/init_db.py (bcrypt-hashed before saving)
SEED_DEMO_PASSWORD=change-me-Demo@123

# ---------- AI provider (choose ONE: openrouter | gemini | azure) ----------
AI_PROVIDER=openrouter
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2                    # one retry on timeout/5xx, never on 401/429
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=1000
PROMPT_VERSION=vera-system-v2.1     # stored in ai_call_logs so answers can be traced to a prompt

# Option A (team choice): OpenRouter, OpenAI-compatible API
OPENROUTER_API_KEY=sk-or-v1-<your-key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# NVIDIA Nemotron 3.5 Super VL (free): supports tool calling and structured output.
# Free endpoint: rate limited and prompts are logged by the provider -> synthetic demo data only.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# The model "thinks" (reasoning) by default; false = faster, plain answers
# (sent as reasoning {"enabled": false} through LangChain extra_body).
OPENROUTER_REASONING_ENABLED=false
OPENROUTER_APP_TITLE=TravelDesk-EY-Capstone

# Option A alternative: Gemini Developer API (free tier)
# GEMINI_API_KEY=<your-key>
# GEMINI_MODEL=<model-name>

# Option B: existing Azure OpenAI / Microsoft Foundry deployment
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=<your-key>
# AZURE_OPENAI_DEPLOYMENT=<deployment-name-not-model-name>
# AZURE_OPENAI_API_VERSION=<api-version>

# ---------- Embeddings for RAG (expense-policy search) ----------
# local = sentence-transformers on CPU (no key, no quota; model downloads once, ~90 MB)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384            # length of policy_chunks.embedding (REAL[]); no pgvector needed

# ---------- RAG ----------
POLICY_DOCUMENT_PATH=data/expense_policy.txt
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.35             # below this, Vera says the answer is not in the policy
POLICY_RULES_VERSION=VGS-FIN-TE-001 v2.0

# ---------- Weather (Open-Meteo, free, no API key) — used ONLY by Vera's tool ----------
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=8
WEATHER_FORECAST_HORIZON_DAYS=16    # today + 15 days; other dates -> FORECAST_OUT_OF_RANGE
WEATHER_CACHE_TTL_MINUTES=180       # in-memory cache key: normalised destination + start + end
WEATHER_AMBIGUITY_MIN_POPULATION=100000  # 2+ matches this big in different countries -> ask user

# ---------- Expense policy: review thresholds per line, INR [POL-6.2] ----------
# Amount ABOVE the threshold -> OVER_THRESHOLD flag -> manager review.
POLICY_THRESHOLD_AIRFARE=20000
POLICY_THRESHOLD_LODGING=7500
POLICY_THRESHOLD_MEALS=1500
POLICY_THRESHOLD_GROUND_TRANSPORT=3000
POLICY_THRESHOLD_INCIDENTALS=1000
# Trip auto-complete [POL-4.3]: an Approved - Active trip becomes Completed this many days
# after its START date. Managers can complete earlier (on/after the end date).
POLICY_TRIP_AUTO_COMPLETE_DAYS_AFTER_START=90

# ---------- Evidence (receipt photos), stored inside PostgreSQL ----------
EVIDENCE_MAX_BYTES=5242880          # 5 MB per photo
EVIDENCE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
EVIDENCE_UNATTACHED_RETENTION_HOURS=24   # uploads never attached to a line are deleted after this

# ---------- Background scheduler (inside FastAPI, no extra service) ----------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60       # auto-complete trips, expire idle chats, clean unattached evidence

# ---------- Chatbot (Vera) ----------
CHAT_IDLE_TIMEOUT_MINUTES=60        # idle longer than this -> session EXPIRED
CHAT_HISTORY_TURNS=8                # last N turns of the CURRENT session sent verbatim
CHAT_CONTEXT_TOKEN_BUDGET=6000      # rough budget for summary + history + tool results
CHAT_MAX_TOOL_CALLS_PER_TURN=4
CHAT_RATE_LIMIT_PER_MINUTE=10       # per employee
CHAT_MAX_MESSAGE_CHARS=1000

# ---------- Error storage and tracing ----------
ERROR_LOG_TO_DB=true                # write error_logs rows; falls back to JSON app logs if the DB fails
ERROR_LOG_STACK_TRACES=true         # store stack traces for 5xx errors only
CORRELATION_HEADER=X-Correlation-ID # read from the request if present, else generated; echoed back

# ---------- Evals ----------
EVAL_USE_LIVE_LLM=false             # true = call the real model in `python -m evals.run_evals`

# ---------- Receipt verification (M3, Spec v2.1) ----------
# Each receipt photo is read once: the vision model (OpenRouter key above) reads amount, date,
# merchant and place; Sightengine checks whether the image is AI-generated or edited.
# The comparison with what the employee typed is plain code. false = feature off (old behaviour).
RECEIPT_CHECK_ENABLED=true
RECEIPT_VISION_MODEL=                     # empty = use OPENROUTER_MODEL (must accept images)
RECEIPT_AMOUNT_TOLERANCE_PCT=1.0          # receipt total may differ by 1% ...
RECEIPT_AMOUNT_TOLERANCE_MIN_INR=10       # ... or Rs 10, whichever is larger
RECEIPT_DATE_TOLERANCE_DAYS=1
RECEIPT_AI_GENERATED_THRESHOLD=0.5        # Sightengine score at or above this fails the check
# Sightengine (sightengine.com > dashboard). Empty = authenticity check skipped.
SIGHTENGINE_API_USER=<your-api-user>
SIGHTENGINE_API_SECRET=<your-api-secret>
SIGHTENGINE_URL=https://api.sightengine.com/1.0/check.json
SIGHTENGINE_TIMEOUT_SECONDS=10


