digraph ER {
graph [fontname="Inter", bgcolor="white", pad=0.3, nodesep=0.3, ranksep=0.55, rankdir=LR, splines=spline];
node [fontname="Inter", fontsize=15, fontcolor="#111827", shape=plain];
edge [color="#374151", penwidth=1.3, arrowsize=0.9, dir=both];
employees [label=<<TABLE BORDER="1" COLOR="#059669" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#D1FAE5"><B>employees</B></TD></TR><TR><TD ALIGN="LEFT" PORT="employee_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="employee_id_e"><B>employee_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name_w"></TD><TD ALIGN="LEFT" PORT="full_name_e">full_name</TD></TR><TR><TD ALIGN="LEFT" PORT="email_w">UK</TD><TD ALIGN="LEFT" PORT="email_e">email</TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash_w"></TD><TD ALIGN="LEFT" PORT="password_hash_e">password_hash</TD></TR><TR><TD ALIGN="LEFT" PORT="department_w"></TD><TD ALIGN="LEFT" PORT="department_e">department</TD></TR><TR><TD ALIGN="LEFT" PORT="role_w"></TD><TD ALIGN="LEFT" PORT="role_e">role</TD></TR><TR><TD ALIGN="LEFT" PORT="manager_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="manager_id_e">manager_id</TD></TR></TABLE>>];
travel_requests [label=<<TABLE BORDER="1" COLOR="#2563EB" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#DBEAFE"><B>travel_requests</B></TD></TR><TR><TD ALIGN="LEFT" PORT="trip_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="trip_id_e"><B>trip_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="trip_code_w">UK</TD><TD ALIGN="LEFT" PORT="trip_code_e">trip_code</TD></TR><TR><TD ALIGN="LEFT" PORT="employee_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="employee_id_e">employee_id</TD></TR><TR><TD ALIGN="LEFT" PORT="destination_w"></TD><TD ALIGN="LEFT" PORT="destination_e">destination</TD></TR><TR><TD ALIGN="LEFT" PORT="start_date_w"></TD><TD ALIGN="LEFT" PORT="start_date_e">start_date</TD></TR><TR><TD ALIGN="LEFT" PORT="end_date_w"></TD><TD ALIGN="LEFT" PORT="end_date_e">end_date</TD></TR><TR><TD ALIGN="LEFT" PORT="purpose_w"></TD><TD ALIGN="LEFT" PORT="purpose_e">purpose</TD></TR><TR><TD ALIGN="LEFT" PORT="approval_status_w"></TD><TD ALIGN="LEFT" PORT="approval_status_e">approval_status</TD></TR><TR><TD ALIGN="LEFT" PORT="trip_state_w"></TD><TD ALIGN="LEFT" PORT="trip_state_e">trip_state</TD></TR><TR><TD ALIGN="LEFT" PORT="completion_type_w"></TD><TD ALIGN="LEFT" PORT="completion_type_e">completion_type</TD></TR><TR><TD ALIGN="LEFT" PORT="completed_by_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="completed_by_e">completed_by</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_w"></TD><TD ALIGN="LEFT" PORT="created_at_e">created_at</TD></TR></TABLE>>];
trip_approvals [label=<<TABLE BORDER="1" COLOR="#2563EB" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#DBEAFE"><B>trip_approvals</B></TD></TR><TR><TD ALIGN="LEFT" PORT="approval_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="approval_id_e"><B>approval_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="trip_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="trip_id_e">trip_id</TD></TR><TR><TD ALIGN="LEFT" PORT="reviewer_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="reviewer_id_e">reviewer_id</TD></TR><TR><TD ALIGN="LEFT" PORT="decision_w"></TD><TD ALIGN="LEFT" PORT="decision_e">decision</TD></TR><TR><TD ALIGN="LEFT" PORT="review_comment_w"></TD><TD ALIGN="LEFT" PORT="review_comment_e">review_comment</TD></TR><TR><TD ALIGN="LEFT" PORT="decided_at_w"></TD><TD ALIGN="LEFT" PORT="decided_at_e">decided_at</TD></TR></TABLE>>];
employees:employee_id_e:e -> travel_requests:employee_id_w:w [arrowtail=teetee, arrowhead=crowodot];
employees:employee_id_e:e -> travel_requests:completed_by_w:w [arrowtail=teetee, arrowhead=crowodot];
travel_requests:trip_id_e:e -> trip_approvals:trip_id_w:w [arrowtail=teetee, arrowhead=teeodot];
employees:employee_id_e:e -> trip_approvals:reviewer_id_w:w [arrowtail=teetee, arrowhead=crowodot];

}