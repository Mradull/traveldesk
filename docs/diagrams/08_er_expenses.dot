digraph ER {
graph [fontname="Inter", bgcolor="white", pad=0.3, nodesep=0.3, ranksep=0.55, rankdir=LR, splines=spline];
node [fontname="Inter", fontsize=15, fontcolor="#111827", shape=plain];
edge [color="#374151", penwidth=1.3, arrowsize=0.9, dir=both];
travel_requests [label=<<TABLE BORDER="1" COLOR="#2563EB" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#DBEAFE"><B>travel_requests</B></TD></TR><TR><TD ALIGN="LEFT" PORT="trip_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="trip_id_e"><B>trip_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="trip_code_w">UK</TD><TD ALIGN="LEFT" PORT="trip_code_e">trip_code</TD></TR><TR><TD ALIGN="LEFT" PORT="approval_status_w"></TD><TD ALIGN="LEFT" PORT="approval_status_e">approval_status</TD></TR><TR><TD ALIGN="LEFT" PORT="trip_state_w"></TD><TD ALIGN="LEFT" PORT="trip_state_e">trip_state</TD></TR></TABLE>>];
expense_tickets [label=<<TABLE BORDER="1" COLOR="#D97706" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#FEF3C7"><B>expense_tickets</B></TD></TR><TR><TD ALIGN="LEFT" PORT="ticket_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="ticket_id_e"><B>ticket_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="ticket_code_w">UK</TD><TD ALIGN="LEFT" PORT="ticket_code_e">ticket_code</TD></TR><TR><TD ALIGN="LEFT" PORT="trip_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="trip_id_e">trip_id</TD></TR><TR><TD ALIGN="LEFT" PORT="employee_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="employee_id_e">employee_id</TD></TR><TR><TD ALIGN="LEFT" PORT="replacement_of_ticket_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="replacement_of_ticket_id_e">replacement_of_ticket_id</TD></TR><TR><TD ALIGN="LEFT" PORT="status_w"></TD><TD ALIGN="LEFT" PORT="status_e">status</TD></TR><TR><TD ALIGN="LEFT" PORT="routing_w"></TD><TD ALIGN="LEFT" PORT="routing_e">routing</TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount_w"></TD><TD ALIGN="LEFT" PORT="total_amount_e">total_amount</TD></TR></TABLE>>];
expenses [label=<<TABLE BORDER="1" COLOR="#D97706" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#FEF3C7"><B>expenses</B></TD></TR><TR><TD ALIGN="LEFT" PORT="expense_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="expense_id_e"><B>expense_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="expense_code_w">UK</TD><TD ALIGN="LEFT" PORT="expense_code_e">expense_code</TD></TR><TR><TD ALIGN="LEFT" PORT="ticket_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="ticket_id_e">ticket_id</TD></TR><TR><TD ALIGN="LEFT" PORT="trip_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="trip_id_e">trip_id</TD></TR><TR><TD ALIGN="LEFT" PORT="evidence_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="evidence_id_e">evidence_id</TD></TR><TR><TD ALIGN="LEFT" PORT="expense_type_w"></TD><TD ALIGN="LEFT" PORT="expense_type_e">expense_type</TD></TR><TR><TD ALIGN="LEFT" PORT="amount_w"></TD><TD ALIGN="LEFT" PORT="amount_e">amount</TD></TR><TR><TD ALIGN="LEFT" PORT="expense_date_w"></TD><TD ALIGN="LEFT" PORT="expense_date_e">expense_date</TD></TR><TR><TD ALIGN="LEFT" PORT="invoice_number_w"></TD><TD ALIGN="LEFT" PORT="invoice_number_e">invoice_number</TD></TR><TR><TD ALIGN="LEFT" PORT="status_w"></TD><TD ALIGN="LEFT" PORT="status_e">status</TD></TR></TABLE>>];
policy_flags [label=<<TABLE BORDER="1" COLOR="#D97706" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#FEF3C7"><B>policy_flags</B></TD></TR><TR><TD ALIGN="LEFT" PORT="flag_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="flag_id_e"><B>flag_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="expense_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="expense_id_e">expense_id</TD></TR><TR><TD ALIGN="LEFT" PORT="rule_code_w"></TD><TD ALIGN="LEFT" PORT="rule_code_e">rule_code</TD></TR><TR><TD ALIGN="LEFT" PORT="message_w"></TD><TD ALIGN="LEFT" PORT="message_e">message</TD></TR></TABLE>>];
ticket_approvals [label=<<TABLE BORDER="1" COLOR="#D97706" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#FEF3C7"><B>ticket_approvals</B></TD></TR><TR><TD ALIGN="LEFT" PORT="approval_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="approval_id_e"><B>approval_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="ticket_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="ticket_id_e">ticket_id</TD></TR><TR><TD ALIGN="LEFT" PORT="reviewer_type_w"></TD><TD ALIGN="LEFT" PORT="reviewer_type_e">reviewer_type</TD></TR><TR><TD ALIGN="LEFT" PORT="reviewer_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="reviewer_id_e">reviewer_id</TD></TR><TR><TD ALIGN="LEFT" PORT="decision_w"></TD><TD ALIGN="LEFT" PORT="decision_e">decision</TD></TR><TR><TD ALIGN="LEFT" PORT="rejection_reason_w"></TD><TD ALIGN="LEFT" PORT="rejection_reason_e">rejection_reason</TD></TR><TR><TD ALIGN="LEFT" PORT="review_comment_w"></TD><TD ALIGN="LEFT" PORT="review_comment_e">review_comment</TD></TR><TR><TD ALIGN="LEFT" PORT="decided_at_w"></TD><TD ALIGN="LEFT" PORT="decided_at_e">decided_at</TD></TR></TABLE>>];
expense_evidence [label=<<TABLE BORDER="1" COLOR="#D97706" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#FEF3C7"><B>expense_evidence</B></TD></TR><TR><TD ALIGN="LEFT" PORT="evidence_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="evidence_id_e"><B>evidence_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="evidence_code_w">UK</TD><TD ALIGN="LEFT" PORT="evidence_code_e">evidence_code</TD></TR><TR><TD ALIGN="LEFT" PORT="employee_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="employee_id_e">employee_id</TD></TR><TR><TD ALIGN="LEFT" PORT="mime_type_w"></TD><TD ALIGN="LEFT" PORT="mime_type_e">mime_type</TD></TR><TR><TD ALIGN="LEFT" PORT="size_bytes_w"></TD><TD ALIGN="LEFT" PORT="size_bytes_e">size_bytes</TD></TR><TR><TD ALIGN="LEFT" PORT="sha256_w"></TD><TD ALIGN="LEFT" PORT="sha256_e">sha256</TD></TR><TR><TD ALIGN="LEFT" PORT="uploaded_at_w"></TD><TD ALIGN="LEFT" PORT="uploaded_at_e">uploaded_at</TD></TR></TABLE>>];
evidence_files [label=<<TABLE BORDER="1" COLOR="#D97706" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#FEF3C7"><B>evidence_files</B></TD></TR><TR><TD ALIGN="LEFT" PORT="evidence_id_w"><B>PK</B> <FONT COLOR='#1D4ED8'><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="evidence_id_e"><B>evidence_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="content_w"></TD><TD ALIGN="LEFT" PORT="content_e">content</TD></TR></TABLE>>];
travel_requests:trip_id_e:e -> expense_tickets:trip_id_w:w [arrowtail=teetee, arrowhead=crowodot];
expense_tickets:ticket_id_e:e -> expenses:ticket_id_w:w [arrowtail=teetee, arrowhead=crowodot];
travel_requests:trip_id_e:e -> expenses:trip_id_w:w [arrowtail=teetee, arrowhead=crowodot];
expense_evidence:evidence_id_e:e -> expenses:evidence_id_w:w [arrowtail=teetee, arrowhead=teeodot];
expense_evidence:evidence_id_e:e -> evidence_files:evidence_id_w:w [arrowtail=teetee, arrowhead=teeodot];
expenses:expense_id_e:e -> policy_flags:expense_id_w:w [arrowtail=teetee, arrowhead=crowodot];
expense_tickets:ticket_id_e:e -> ticket_approvals:ticket_id_w:w [arrowtail=teetee, arrowhead=teeodot];
{rank=same; expense_tickets; expense_evidence}
}