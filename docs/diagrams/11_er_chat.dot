digraph ER {
graph [fontname="Inter", bgcolor="white", pad=0.3, nodesep=0.3, ranksep=0.55, rankdir=LR, splines=spline];
node [fontname="Inter", fontsize=15, fontcolor="#111827", shape=plain];
edge [color="#374151", penwidth=1.3, arrowsize=0.9, dir=both];
employees [label=<<TABLE BORDER="1" COLOR="#059669" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#D1FAE5"><B>employees</B></TD></TR><TR><TD ALIGN="LEFT" PORT="employee_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="employee_id_e"><B>employee_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name_w"></TD><TD ALIGN="LEFT" PORT="full_name_e">full_name</TD></TR></TABLE>>];
chat_sessions [label=<<TABLE BORDER="1" COLOR="#7C3AED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EDE9FE"><B>chat_sessions</B></TD></TR><TR><TD ALIGN="LEFT" PORT="session_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="session_id_e"><B>session_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="employee_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="employee_id_e">employee_id</TD></TR><TR><TD ALIGN="LEFT" PORT="status_w"></TD><TD ALIGN="LEFT" PORT="status_e">status</TD></TR><TR><TD ALIGN="LEFT" PORT="close_reason_w"></TD><TD ALIGN="LEFT" PORT="close_reason_e">close_reason</TD></TR><TR><TD ALIGN="LEFT" PORT="summary_w"></TD><TD ALIGN="LEFT" PORT="summary_e">summary</TD></TR><TR><TD ALIGN="LEFT" PORT="summarized_upto_turn_w"></TD><TD ALIGN="LEFT" PORT="summarized_upto_turn_e">summarized_upto_turn</TD></TR><TR><TD ALIGN="LEFT" PORT="started_at_w"></TD><TD ALIGN="LEFT" PORT="started_at_e">started_at</TD></TR><TR><TD ALIGN="LEFT" PORT="last_activity_at_w"></TD><TD ALIGN="LEFT" PORT="last_activity_at_e">last_activity_at</TD></TR><TR><TD ALIGN="LEFT" PORT="closed_at_w"></TD><TD ALIGN="LEFT" PORT="closed_at_e">closed_at</TD></TR></TABLE>>];
chat_conversations [label=<<TABLE BORDER="1" COLOR="#7C3AED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EDE9FE"><B>chat_conversations</B></TD></TR><TR><TD ALIGN="LEFT" PORT="conversation_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="conversation_id_e"><B>conversation_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="session_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="session_id_e">session_id</TD></TR><TR><TD ALIGN="LEFT" PORT="turn_number_w"></TD><TD ALIGN="LEFT" PORT="turn_number_e">turn_number</TD></TR><TR><TD ALIGN="LEFT" PORT="intent_w"></TD><TD ALIGN="LEFT" PORT="intent_e">intent</TD></TR><TR><TD ALIGN="LEFT" PORT="status_w"></TD><TD ALIGN="LEFT" PORT="status_e">status</TD></TR><TR><TD ALIGN="LEFT" PORT="guardrail_status_w"></TD><TD ALIGN="LEFT" PORT="guardrail_status_e">guardrail_status</TD></TR><TR><TD ALIGN="LEFT" PORT="correlation_id_w"></TD><TD ALIGN="LEFT" PORT="correlation_id_e">correlation_id</TD></TR><TR><TD ALIGN="LEFT" PORT="latency_ms_w"></TD><TD ALIGN="LEFT" PORT="latency_ms_e">latency_ms</TD></TR></TABLE>>];
chat_messages [label=<<TABLE BORDER="1" COLOR="#7C3AED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EDE9FE"><B>chat_messages</B></TD></TR><TR><TD ALIGN="LEFT" PORT="message_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="message_id_e"><B>message_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="session_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="session_id_e">session_id</TD></TR><TR><TD ALIGN="LEFT" PORT="conversation_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="conversation_id_e">conversation_id</TD></TR><TR><TD ALIGN="LEFT" PORT="sequence_no_w"></TD><TD ALIGN="LEFT" PORT="sequence_no_e">sequence_no</TD></TR><TR><TD ALIGN="LEFT" PORT="message_type_w"></TD><TD ALIGN="LEFT" PORT="message_type_e">message_type</TD></TR><TR><TD ALIGN="LEFT" PORT="content_w"></TD><TD ALIGN="LEFT" PORT="content_e">content</TD></TR><TR><TD ALIGN="LEFT" PORT="tool_name_w"></TD><TD ALIGN="LEFT" PORT="tool_name_e">tool_name</TD></TR><TR><TD ALIGN="LEFT" PORT="tool_call_id_w"></TD><TD ALIGN="LEFT" PORT="tool_call_id_e">tool_call_id</TD></TR><TR><TD ALIGN="LEFT" PORT="tool_args_w"></TD><TD ALIGN="LEFT" PORT="tool_args_e">tool_args</TD></TR><TR><TD ALIGN="LEFT" PORT="metadata_w"></TD><TD ALIGN="LEFT" PORT="metadata_e">metadata</TD></TR></TABLE>>];
policy_chunks [label=<<TABLE BORDER="1" COLOR="#7C3AED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EDE9FE"><B>policy_chunks</B></TD></TR><TR><TD ALIGN="LEFT" PORT="chunk_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="chunk_id_e"><B>chunk_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="ref_id_w"></TD><TD ALIGN="LEFT" PORT="ref_id_e">ref_id</TD></TR><TR><TD ALIGN="LEFT" PORT="section_title_w"></TD><TD ALIGN="LEFT" PORT="section_title_e">section_title</TD></TR><TR><TD ALIGN="LEFT" PORT="content_w"></TD><TD ALIGN="LEFT" PORT="content_e">content</TD></TR><TR><TD ALIGN="LEFT" PORT="embedding_w"></TD><TD ALIGN="LEFT" PORT="embedding_e">embedding</TD></TR><TR><TD ALIGN="LEFT" PORT="content_hash_w">UK</TD><TD ALIGN="LEFT" PORT="content_hash_e">content_hash</TD></TR></TABLE>>];
employees:employee_id_e:e -> chat_sessions:employee_id_w:w [arrowtail=teetee, arrowhead=crowodot];
chat_sessions:session_id_e:e -> chat_conversations:session_id_w:w [arrowtail=teetee, arrowhead=crowodot];
chat_conversations:conversation_id_e:e -> chat_messages:conversation_id_w:w [arrowtail=teetee, arrowhead=crowodot];
chat_sessions:session_id_e:e -> chat_messages:session_id_w:w [arrowtail=teetee, arrowhead=crowodot];
{rank=same; policy_chunks; employees}
}