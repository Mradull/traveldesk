digraph ER {
graph [fontname="Inter", bgcolor="white", pad=0.3, nodesep=0.3, ranksep=0.55, rankdir=LR, splines=spline];
node [fontname="Inter", fontsize=15, fontcolor="#111827", shape=plain];
edge [color="#374151", penwidth=1.3, arrowsize=0.9, dir=both];
chat_conversations [label=<<TABLE BORDER="1" COLOR="#7C3AED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#EDE9FE"><B>chat_conversations</B></TD></TR><TR><TD ALIGN="LEFT" PORT="conversation_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="conversation_id_e"><B>conversation_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="session_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="session_id_e">session_id</TD></TR><TR><TD ALIGN="LEFT" PORT="turn_number_w"></TD><TD ALIGN="LEFT" PORT="turn_number_e">turn_number</TD></TR><TR><TD ALIGN="LEFT" PORT="correlation_id_w"></TD><TD ALIGN="LEFT" PORT="correlation_id_e">correlation_id</TD></TR></TABLE>>];
ai_call_logs [label=<<TABLE BORDER="1" COLOR="#6B7280" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#F3F4F6"><B>ai_call_logs</B></TD></TR><TR><TD ALIGN="LEFT" PORT="log_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="log_id_e"><B>log_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="session_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="session_id_e">session_id</TD></TR><TR><TD ALIGN="LEFT" PORT="conversation_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="conversation_id_e">conversation_id</TD></TR><TR><TD ALIGN="LEFT" PORT="feature_w"></TD><TD ALIGN="LEFT" PORT="feature_e">feature</TD></TR><TR><TD ALIGN="LEFT" PORT="model_name_w"></TD><TD ALIGN="LEFT" PORT="model_name_e">model_name</TD></TR><TR><TD ALIGN="LEFT" PORT="prompt_version_w"></TD><TD ALIGN="LEFT" PORT="prompt_version_e">prompt_version</TD></TR><TR><TD ALIGN="LEFT" PORT="status_w"></TD><TD ALIGN="LEFT" PORT="status_e">status</TD></TR><TR><TD ALIGN="LEFT" PORT="latency_ms_w"></TD><TD ALIGN="LEFT" PORT="latency_ms_e">latency_ms</TD></TR><TR><TD ALIGN="LEFT" PORT="correlation_id_w"></TD><TD ALIGN="LEFT" PORT="correlation_id_e">correlation_id</TD></TR></TABLE>>];
rag_call_logs [label=<<TABLE BORDER="1" COLOR="#6B7280" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#F3F4F6"><B>rag_call_logs</B></TD></TR><TR><TD ALIGN="LEFT" PORT="rag_call_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="rag_call_id_e"><B>rag_call_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="session_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="session_id_e">session_id</TD></TR><TR><TD ALIGN="LEFT" PORT="conversation_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="conversation_id_e">conversation_id</TD></TR><TR><TD ALIGN="LEFT" PORT="retrieved_ref_ids_w"></TD><TD ALIGN="LEFT" PORT="retrieved_ref_ids_e">retrieved_ref_ids</TD></TR><TR><TD ALIGN="LEFT" PORT="retrieval_scores_w"></TD><TD ALIGN="LEFT" PORT="retrieval_scores_e">retrieval_scores</TD></TR><TR><TD ALIGN="LEFT" PORT="citations_used_w"></TD><TD ALIGN="LEFT" PORT="citations_used_e">citations_used</TD></TR><TR><TD ALIGN="LEFT" PORT="status_w"></TD><TD ALIGN="LEFT" PORT="status_e">status</TD></TR><TR><TD ALIGN="LEFT" PORT="latency_ms_w"></TD><TD ALIGN="LEFT" PORT="latency_ms_e">latency_ms</TD></TR></TABLE>>];
weather_tool_logs [label=<<TABLE BORDER="1" COLOR="#6B7280" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#F3F4F6"><B>weather_tool_logs</B></TD></TR><TR><TD ALIGN="LEFT" PORT="weather_call_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="weather_call_id_e"><B>weather_call_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="session_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="session_id_e">session_id</TD></TR><TR><TD ALIGN="LEFT" PORT="conversation_id_w"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="conversation_id_e">conversation_id</TD></TR><TR><TD ALIGN="LEFT" PORT="tool_call_id_w"></TD><TD ALIGN="LEFT" PORT="tool_call_id_e">tool_call_id</TD></TR><TR><TD ALIGN="LEFT" PORT="destination_query_w"></TD><TD ALIGN="LEFT" PORT="destination_query_e">destination_query</TD></TR><TR><TD ALIGN="LEFT" PORT="start_date_w"></TD><TD ALIGN="LEFT" PORT="start_date_e">start_date</TD></TR><TR><TD ALIGN="LEFT" PORT="end_date_w"></TD><TD ALIGN="LEFT" PORT="end_date_e">end_date</TD></TR><TR><TD ALIGN="LEFT" PORT="result_status_w"></TD><TD ALIGN="LEFT" PORT="result_status_e">result_status</TD></TR><TR><TD ALIGN="LEFT" PORT="error_code_w"></TD><TD ALIGN="LEFT" PORT="error_code_e">error_code</TD></TR><TR><TD ALIGN="LEFT" PORT="cache_hit_w"></TD><TD ALIGN="LEFT" PORT="cache_hit_e">cache_hit</TD></TR></TABLE>>];
error_logs [label=<<TABLE BORDER="1" COLOR="#6B7280" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#F3F4F6"><B>error_logs</B></TD></TR><TR><TD ALIGN="LEFT" PORT="error_id_w"><B>PK</B></TD><TD ALIGN="LEFT" PORT="error_id_e"><B>error_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="occurred_at_w"></TD><TD ALIGN="LEFT" PORT="occurred_at_e">occurred_at</TD></TR><TR><TD ALIGN="LEFT" PORT="category_w"></TD><TD ALIGN="LEFT" PORT="category_e">category</TD></TR><TR><TD ALIGN="LEFT" PORT="error_code_w"></TD><TD ALIGN="LEFT" PORT="error_code_e">error_code</TD></TR><TR><TD ALIGN="LEFT" PORT="request_id_w"></TD><TD ALIGN="LEFT" PORT="request_id_e">request_id</TD></TR><TR><TD ALIGN="LEFT" PORT="correlation_id_w"></TD><TD ALIGN="LEFT" PORT="correlation_id_e">correlation_id</TD></TR><TR><TD ALIGN="LEFT" PORT="session_id_w"></TD><TD ALIGN="LEFT" PORT="session_id_e">session_id</TD></TR><TR><TD ALIGN="LEFT" PORT="conversation_id_w"></TD><TD ALIGN="LEFT" PORT="conversation_id_e">conversation_id</TD></TR><TR><TD ALIGN="LEFT" PORT="http_status_w"></TD><TD ALIGN="LEFT" PORT="http_status_e">http_status</TD></TR></TABLE>>];
chat_conversations:conversation_id_e:e -> ai_call_logs:conversation_id_w:w [arrowtail=teetee, arrowhead=crowodot];
chat_conversations:conversation_id_e:e -> rag_call_logs:conversation_id_w:w [arrowtail=teetee, arrowhead=crowodot];
chat_conversations:conversation_id_e:e -> weather_tool_logs:conversation_id_w:w [arrowtail=teetee, arrowhead=crowodot];
{rank=same; error_logs; chat_conversations}
}